<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView forced to render into a TextureView instead of the default
  SurfaceView. The player is shown as a Compose overlay on top of other
  Compose content; a SurfaceView renders in a separate window layer *behind*
  the app surface and gets occluded (black screen). A TextureView draws
  inside the normal view hierarchy and composites correctly with Compose.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:resize_mode="fit"
    app:use_controller="false"
    app:show_buffering="when_playing" />
